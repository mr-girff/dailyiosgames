---
// Google Trends search interest. Server-rendered, no JS.
import { sparkGeom } from "../lib/spark"

const { trend } = Astro.props
const W = 320, H = 78
const geom = sparkGeom((trend?.points || []).map((p: any) => p?.v), W, H, 6)
if (!geom) return null

const slope = Number(trend?.slopePct ?? 0)
const label = slope > 15 ? "rising" : slope < -15 ? "declining" : "stable"
---
<figure class="spark">
  <svg
    class="spark__chart"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    role="img"
    aria-label={`Google Trends search interest, ${label} (${slope >= 0 ? "+" : ""}${slope}% versus the prior 8 weeks)`}
  >
    <path d={geom.area} class="spark-fill" />
    <path d={geom.line} class="spark-line" vector-effect="non-scaling-stroke" />
    <circle cx={geom.lastX.toFixed(1)} cy={geom.lastY.toFixed(1)} r="3.5" class="spark-dot" />
  </svg>
  <figcaption class="spark__cap">
    Google Trends · last 3 months · {label}
    <strong class={slope >= 0 ? "is-up" : "is-down"}>{slope >= 0 ? "+" : ""}{slope}%</strong>
  </figcaption>
</figure>

<style>
  .spark { margin: .85rem 0 0; max-width: 420px; }
  .spark__chart {
    display: block; width: 100%; height: 78px;
    background: linear-gradient(180deg, var(--bg-elev), var(--muted));
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .spark__cap { font-size: .76rem; color: var(--fg-muted); margin-top: .35rem; }
  .spark__cap .is-up { color: #35754b; margin-left: .25rem; }
  .spark__cap .is-down { color: #a2503f; margin-left: .25rem; }
</style>
