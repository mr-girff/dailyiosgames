---
import Base from "../../layouts/Base.astro"
import Hero from "../../components/Hero.astro"
import TrendSparkline from "../../components/TrendSparkline.astro"
import HeatSparkline from "../../components/HeatSparkline.astro"
import Reviews from "../../components/Reviews.astro"
import Subscribe from "../../components/Subscribe.astro"
import KeepBrowsing from "../../components/KeepBrowsing.astro"
import ShareRow from "../../components/ShareRow.astro"
import { appStoreUrl } from "../../lib/appstore"
import { loadEnriched } from "../../lib/enriched"
import { compactNum, growthLabel } from "../../lib/spark"
import { monetizationLabel } from "../../lib/format"

export async function getStaticPaths() {
  const data = loadEnriched()
  return (data.all || []).map(g => ({ params: { id: g.id }, props: { game: g, all: data.all } }))
}

const { game, all } = Astro.props
const storeUrl = appStoreUrl(game)
const robots = game.indexDirective || "index,follow"
const canonical = `${Astro.site || ""}games/${game.id}/`.replace(/\/+/g,"/").replace(":/","://")

// `similar` holds ids only; resolve against the catalogue. Tolerates the older
// [{ id, name }] shape so a stale data/enriched.json still renders.
const byId = new Map(all.map(g => [g.id, g]))
const similar = (game.similar || [])
  .map(s => byId.get(typeof s === "string" ? s : s?.id))
  .filter(Boolean)
  .slice(0, 6)
const sameStudio = all.filter(g => g.id !== game.id && g.seller === game.seller).slice(0, 4)

// Prev / next within the same archetype, ranked by heat (then name)
const sameArch = all
  .filter(g => g.archetype === game.archetype && g.indexDirective?.startsWith("index"))
  .sort((a, b) => (b.heatScore || 0) - (a.heatScore || 0) || (a.name || "").localeCompare(b.name || ""))
const idx = sameArch.findIndex(g => g.id === game.id)
const prevGame = idx > 0 ? sameArch[idx - 1] : null
const nextGame = idx >= 0 && idx < sameArch.length - 1 ? sameArch[idx + 1] : null

// "Keep browsing" card items (top of funnel into other site sections)
const kbItems = [
  { href: `/archetype/${game.archetype}/`, title: `More ${capitalize(game.archetype)} games`, sub: `${sameArch.length} tracked`, icon: "tag" },
  { href: "/movers/", title: "Rising right now", sub: "Today's hottest movers", icon: "fire" },
  { href: "/posts/",  title: "Today's daily report", sub: "Every new game on the US App Store", icon: "calendar" },
  { href: "/games/",  title: "All tracked games",  sub: `${all.length} games`, icon: "list" },
]

const title = `${game.name} — ${capitalize(game.archetype)} game by ${game.seller}`
const description = oneLine(`${game.name} is a ${game.archetype} game by ${game.seller}. ${game.uniqueHook || game.coreLoop || ""} Latest version ${game.version} (${game.currentVersionDate}). Rating ${game.rating || "n/a"} from ${game.ratingCount || 0} reviews.`)

// Key-stat strip. Every tile is data we actually hold — no placeholders, and a
// tile is dropped entirely rather than rendered as "—".
const chartRank = game.rank?.free ?? game.rank?.grossing ?? game.rank?.new ?? null
const chartRankLabel = game.rank?.free ? "Free chart" : game.rank?.grossing ? "Grossing chart" : game.rank?.new ? "New chart" : ""
const growth7d = growthLabel(game.velocity?.rcGrowthPct)
const added7d = Number(game.velocity?.rcDelta7d || 0)
const daysTracked = Number(game.velocity?.daysTracked || 0)

const stats = [
  typeof game.heatScore === "number" && game.heatScore > 0 && {
    label: "Heat score",
    value: String(game.heatScore),
    note: "of 100 · early traction",
    accent: true,
    meter: game.heatScore,
  },
  game.rating > 0 && {
    label: "App Store rating",
    value: `★ ${game.rating.toFixed(1)}`,
    note: game.ratingCount ? `${compactNum(game.ratingCount)} ratings` : "",
  },
  added7d > 0 && {
    label: "New ratings · 7d",
    value: `+${compactNum(added7d)}`,
    note: growth7d ? `${growth7d} week over week` : "",
  },
  chartRank && { label: chartRankLabel, value: `#${chartRank}`, note: "US App Store, today" },
  daysTracked > 0 && {
    label: "Tracked for",
    value: `${daysTracked}d`,
    note: game.velocity?.presenceStreak ? `${game.velocity.presenceStreak}-day chart streak` : "",
  },
].filter(Boolean) as { label: string; value: string; note?: string; accent?: boolean; meter?: number }[]

const shareText = oneLine(
  `${game.name} — ${game.uniqueHook || game.coreLoop || `${capitalize(game.archetype)} game by ${game.seller}`}`,
)

// Truncate on a word boundary. A hard .slice(0, 240) was cutting the visible
// TL;DR mid-word ("…and help the frien") on every long description.
function oneLine(s, max = 240){
  const t = (s || "").replace(/\s+/g, " ").trim()
  if (t.length <= max) return t
  const cut = t.slice(0, max - 1)
  const at = cut.lastIndexOf(" ")
  return (at > max * 0.6 ? cut.slice(0, at) : cut).replace(/[,;:.\s]+$/, "") + "…"
}
function capitalize(s){ return (s||"").replace(/(^|-)\w/g, c => c.toUpperCase()).replace(/-/g," ") }
---
<Base
  title={title}
  description={description}
  canonical={canonical}
  robots={robots}
  image={game.icon}
  ogType="article"
  bodyClass={`theme-${game.archetype}`}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href={`/archetype/${game.archetype}/`}>{capitalize(game.archetype)}</a> › <span>{game.name}</span>
  </nav>

  <Hero game={game} />

  {game.active === false && (
    <p class="archived-note">
      <strong>Archived entry.</strong> This game last appeared on a US App Store chart we
      track on <time datetime={game.lastSeen}>{game.lastSeen}</time>
      {game.daysSinceSeen != null && ` (${game.daysSinceSeen} days ago)`}, so the figures
      below are from that date. The page is kept online so links to it keep working —
      check the App Store for current details.
    </p>
  )}

  {game.video?.mp4 && (
    <section>
      <h2>15-second look</h2>
      <video controls preload="none" poster={game.video.poster} width="540" height="960" playsinline>
        <source src={game.video.mp4} type="video/mp4" />
      </video>
      <p class="caveat">Auto-generated montage of the developer's official screenshots with synthesized narration. Not actual gameplay footage.</p>
    </section>
  )}

  {stats.length > 0 && (
    <ul class="stat-strip">
      {stats.map(s => (
        <li class="stat-tile">
          <span class="stat-tile__label">{s.label}</span>
          <span class={`stat-tile__value${s.accent ? " is-accent" : ""}`}>{s.value}</span>
          {s.note && <span class="stat-tile__note">{s.note}</span>}
          {typeof s.meter === "number" && (
            <span class="stat-tile__meter" aria-hidden="true"><i style={`width:${Math.max(2, Math.min(100, s.meter))}%`}></i></span>
          )}
        </li>
      ))}
    </ul>
  )}

  <p class="tldr"><strong>TL;DR</strong><br/>{description}</p>

  <ShareRow url={canonical} title={game.name} text={shareText} label="Share this game" compact={true} />

  {game.velocity?.rcSeries?.length >= 2 && (
    <section>
      <h2>Momentum</h2>
      <div class="momentum-row">
        {game.momentum && <span class={`badge m-${game.momentum}`}>{
          { surging:"🔥 Surging", rising:"📈 Rising", steady:"Steady", fading:"Fading" }[game.momentum] || game.momentum
        }</span>}
        {game.traction === "strong" && <span class="badge badge--strong">Strong traction</span>}
        {typeof game.heatScore === "number" && <span class="badge">Heat {game.heatScore}/100</span>}
      </div>
      <HeatSparkline velocity={game.velocity} />
      <p class="caveat">Rating count is a public proxy for downloads. Trajectory derived from our own daily App Store snapshots.</p>
    </section>
  )}

  {game.trends?.points?.length > 1 && (
    <section>
      <h2>Search interest</h2>
      <TrendSparkline trend={game.trends} />
    </section>
  )}

  <section>
    <h2>What kind of game this is</h2>
    <dl class="facts">
      <div><dt>Genre</dt><dd>{(game.genres || []).join(", ") || "Games"}</dd></div>
      <div><dt>Core loop</dt><dd>{game.coreLoop || "—"}</dd></div>
      <div><dt>Typical session</dt><dd>{game.sessionLength || "—"}</dd></div>
      <div><dt>Built for</dt><dd>{game.audience || "—"}</dd></div>
      <div><dt>Monetization</dt><dd>{monetizationLabel(game)}</dd></div>
      {game.tags?.length > 0 && <div><dt>Features</dt><dd>{game.tags.join(" · ")}</dd></div>}
    </dl>
  </section>

  {game.uniqueHook && (
    <section>
      <h2>What stands out</h2>
      <blockquote>{game.uniqueHook}</blockquote>
    </section>
  )}

  {game.redFlags?.length > 0 && (
    <section>
      <h2>Things to watch out for</h2>
      <ul>{game.redFlags.map(f => <li>{f}</li>)}</ul>
      <p class="caveat">Observations based on official App Store metadata; verify in-game before purchasing.</p>
    </section>
  )}

  {game.releaseNotes && (
    <section>
      <h2>What's new in v{game.version}</h2>
      <p class="meta">Released {game.currentVersionDate} ({game.daysSinceUpdate}d ago)</p>
      <pre class="release-notes">{game.releaseNotes}</pre>
    </section>
  )}

  <section>
    <h2>About {game.name}</h2>
    <div class="desc">{game.desc}</div>
  </section>

  {similar.length > 0 && (
    <section>
      <h2>Similar {capitalize(game.archetype)} games</h2>
      <ul class="link-grid">
        {similar.map(s => <li><a href={`/games/${s.id}/`}>{s.name}</a><small>{s.seller}</small></li>)}
      </ul>
    </section>
  )}

  {sameStudio.length > 0 && (
    <section>
      <h2>More from {game.seller}</h2>
      <ul class="link-grid">
        {sameStudio.map(s => <li><a href={`/games/${s.id}/`}>{s.name}</a></li>)}
      </ul>
    </section>
  )}

  <Reviews gameId={game.id} gameName={game.name} />

  <section class="cta-block">
    <h2 style="margin-top:0">Download {game.name}</h2>
    <a class="cta" href={storeUrl} rel="nofollow noopener" target="_blank">Open on the App Store →</a>
  </section>

  <Subscribe variant="inline" source={`game-${game.id}`} />

  <section>
    <h2>FAQ</h2>
    <details><summary>Is {game.name} free?</summary><p>{game.price === "Free" || !game.price ? `Yes — free to download. Monetization model: ${game.monetization || "unknown"}.` : `It costs ${game.price}.`}</p></details>
    <details><summary>How long is a typical play session?</summary><p>{game.sessionLength || "Varies by player."}</p></details>
    <details><summary>Does {game.name} work offline?</summary><p>{game.tags?.includes("offline") ? "Yes, it supports offline play." : "Apple's listing does not explicitly mention offline support; an internet connection may be required."}</p></details>
    <details><summary>When was the last update?</summary><p>Version {game.version} was released on {game.currentVersionDate}, {game.daysSinceUpdate} day(s) ago.</p></details>
  </section>

  <KeepBrowsing title="Don't stop here" eyebrow="Keep browsing" items={kbItems} />

  {(prevGame || nextGame) && (
    <nav class="prev-next" aria-label={`Other ${capitalize(game.archetype)} games`}>
      {prevGame ? (
        <a class="pn-prev" href={`/games/${prevGame.id}/`} rel="prev">
          <span class="pn-dir">
            <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
            Higher heat
          </span>
          <span class="pn-title">{prevGame.name}</span>
        </a>
      ) : <span></span>}
      {nextGame ? (
        <a class="pn-next" href={`/games/${nextGame.id}/`} rel="next">
          <span class="pn-dir">
            Lower heat
            <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
          </span>
          <span class="pn-title">{nextGame.name}</span>
        </a>
      ) : <span></span>}
    </nav>
  )}

  {game.video?.mp4 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context":"https://schema.org","@type":"VideoObject",
      "name": `${game.name} — 15-second look`,
      "description": `Auto-generated visual montage of ${game.name} with narrated overview.`,
      "thumbnailUrl": (Astro.site||"") + game.video.poster.replace(/^\//,""),
      "uploadDate": new Date().toISOString().slice(0,10),
      "duration": "PT15S",
      "contentUrl": (Astro.site||"") + game.video.mp4.replace(/^\//,""),
      "publisher": { "@type":"Organization", "name": import.meta.env.PUBLIC_SITE_NAME || "Daily Games" }
    })} />
  )}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org","@type":"VideoGame",
    "name": game.name,
    "applicationCategory":"GameApplication",
    "operatingSystem":"iOS",
    "genre": game.genres,
    "softwareVersion": game.version,
    "datePublished": game.releaseDate,
    "url": canonical,
    "image": game.icon,
    "publisher": { "@type":"Organization", "name": game.seller },
    "offers": { "@type":"Offer", "price": game.price === "Free" ? "0" : (game.price || "").replace(/[^\d.]/g,"") || "0", "priceCurrency":"USD", "url": storeUrl },
    ...(game.ratingCount ? { "aggregateRating": { "@type":"AggregateRating", "ratingValue": game.rating, "ratingCount": game.ratingCount }} : {}),
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org","@type":"BreadcrumbList",
    "itemListElement":[
      { "@type":"ListItem","position":1,"name":"Home","item": (Astro.site||"") + "" },
      { "@type":"ListItem","position":2,"name": capitalize(game.archetype), "item": (Astro.site||"") + `archetype/${game.archetype}/` },
      { "@type":"ListItem","position":3,"name": game.name, "item": canonical },
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org","@type":"FAQPage",
    "mainEntity":[
      { "@type":"Question","name":`Is ${game.name} free?`, "acceptedAnswer":{ "@type":"Answer","text": game.price === "Free" || !game.price ? `Yes — free to download.` : `It costs ${game.price}.`}},
      { "@type":"Question","name":"How long is a typical play session?", "acceptedAnswer":{"@type":"Answer","text": game.sessionLength || "Varies."}},
      { "@type":"Question","name": `Does ${game.name} work offline?`, "acceptedAnswer":{"@type":"Answer","text": game.tags?.includes("offline") ? "Yes." : "Apple's listing does not explicitly mention offline support."}},
      { "@type":"Question","name":"When was the last update?", "acceptedAnswer":{"@type":"Answer","text": `Version ${game.version} on ${game.currentVersionDate}.`}},
    ]
  })} />

  <style>
    .archived-note {
      margin: 1rem 0 0; padding: .8rem 1rem;
      background: rgba(127,127,127,.08); border-left: 3px solid var(--border-strong);
      border-radius: 8px; font-size: .88rem; color: var(--fg-muted);
    }
    .momentum-row { display:flex; gap:.4rem; flex-wrap:wrap; margin:.25rem 0 .75rem; }
    .momentum-row :global(.badge) { font-size:.76rem; padding:.22rem .65rem; }
  </style>
</Base>
