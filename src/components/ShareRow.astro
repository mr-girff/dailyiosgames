---
// Share affordance for data pages.
//
// Progressive enhancement, in this order:
//   1. No JS  -> three real <a> intents (X / Reddit / Hacker News) that work.
//   2. JS     -> "Copy link" button becomes functional.
//   3. Mobile -> if navigator.share exists, a native Share button is revealed
//                and the intent links are collapsed behind it.
//
// The URL has to be absolute and known at build time (the site is static), so
// callers pass the same canonical they gave <Base>.
const {
  url,
  title,
  text = "",
  label = "Share",
  compact = false,
} = Astro.props

const u = encodeURIComponent(url)
const t = encodeURIComponent(title)
const shareText = text || title
---
<div
  class:list={["share-row", compact && "share-row--compact"]}
  data-share
  data-url={url}
  data-title={title}
  data-text={shareText}
>
  <span class="share-row__label">{label}</span>

  <button class="share-btn share-btn--native" type="button" hidden data-share-native>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0L8 8m4-4l4 4M5 14v4a2 2 0 002 2h10a2 2 0 002-2v-4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    <span>Share</span>
  </button>

  <div class="share-row__intents" data-share-intents>
    <a class="share-btn" href={`https://x.com/intent/post?text=${t}&url=${u}`} target="_blank" rel="noopener nofollow" aria-label="Share on X">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h4.2l4.5 6.1L17.4 3H21l-7.1 8.1L21.4 21h-4.2l-4.9-6.6L6.6 21H3l7.5-8.6L3 3z" fill="currentColor"/></svg>
      <span>X</span>
    </a>
    <a class="share-btn" href={`https://www.reddit.com/submit?url=${u}&title=${t}`} target="_blank" rel="noopener nofollow" aria-label="Share on Reddit">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="9.2" cy="12.6" r="1.1" fill="currentColor"/><circle cx="14.8" cy="12.6" r="1.1" fill="currentColor"/><path d="M9 16.2c1.8 1.1 4.2 1.1 6 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/><path d="M14.6 5.2L15.6 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="16" cy="4.6" r="1.4" fill="currentColor"/><path d="M20 10.4a1.7 1.7 0 011 3M4 10.4a1.7 1.7 0 00-1 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>
      <span>Reddit</span>
    </a>
    <a class="share-btn" href={`https://news.ycombinator.com/submitlink?u=${u}&t=${t}`} target="_blank" rel="noopener nofollow" aria-label="Share on Hacker News">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 8l4 5m0 0l4-5m-4 5v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
      <span>HN</span>
    </a>
  </div>

  <button class="share-btn share-btn--copy" type="button" data-share-copy hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15 5.5A2.5 2.5 0 0012.5 4h-6A2.5 2.5 0 004 6.5v6A2.5 2.5 0 006.5 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    <span data-share-copy-label>Copy link</span>
  </button>
</div>

<script>
  // One delegated handler for every ShareRow on the page. Astro hoists this
  // module once no matter how many times the component is rendered.
  const rows = document.querySelectorAll<HTMLElement>("[data-share]")
  const canShare = typeof navigator !== "undefined" && typeof navigator.share === "function"
  const canCopy = typeof navigator !== "undefined" && !!navigator.clipboard

  rows.forEach(row => {
    const url = row.dataset.url || location.href
    const title = row.dataset.title || document.title
    const text = row.dataset.text || title

    const nativeBtn = row.querySelector<HTMLButtonElement>("[data-share-native]")
    const copyBtn = row.querySelector<HTMLButtonElement>("[data-share-copy]")

    if (canCopy && copyBtn) {
      copyBtn.hidden = false
      const labelEl = copyBtn.querySelector("[data-share-copy-label]")!
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(url)
          const prev = labelEl.textContent
          copyBtn.classList.add("is-done")
          labelEl.textContent = "Copied"
          setTimeout(() => {
            labelEl.textContent = prev
            copyBtn.classList.remove("is-done")
          }, 1800)
        } catch {
          /* clipboard blocked — the intent links still work */
        }
      })
    }

    if (canShare && nativeBtn) {
      nativeBtn.hidden = false
      row.classList.add("share-row--has-native")
      nativeBtn.addEventListener("click", () => {
        navigator.share({ title, text, url }).catch(() => {})
      })
    }
  })
</script>
