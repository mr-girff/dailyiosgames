---
// "Today's Movers" — games ranked by heatScore (computed by velocity.mjs).
// Surfaces small/mid games taking off early, not just incumbents.
// Renders nothing until velocity data exists, so it degrades gracefully on the
// first deploy, before the daily pipeline has run the velocity step.
//
// Shares the leaderboard styling with /movers/ (see public/styles.css) so the
// homepage teaser and the full page cannot drift apart.
import { cap, priceLabel, gameIconSrc } from "../lib/enriched"
import { sparkGeom, rcValues, growthLabel } from "../lib/spark"

const { games = [], limit = 12 } = Astro.props

const ranked = games
  .filter((g: any) => typeof g.heatScore === "number" && g.heatScore > 0)
  .sort((a: any, b: any) => (b.heatScore || 0) - (a.heatScore || 0))
  .slice(0, limit)

const MOMENTUM: Record<string, { label: string; cls: string }> = {
  surging: { label: "🔥 Surging", cls: "m-surging" },
  rising: { label: "📈 Rising", cls: "m-rising" },
  steady: { label: "Steady", cls: "m-steady" },
  fading: { label: "Fading", cls: "m-fading" },
}
---
{ranked.length > 0 && (
  <section class="movers">
    <div class="section-head">
      <h2>Today's Movers</h2>
      <a class="more" href="/movers/">Ranked by early-traction heat · see all →</a>
    </div>
    <ol class="mover-list mover-list--v2">
      {ranked.map((g: any, i: number) => {
        const m = MOMENTUM[g.momentum] || MOMENTUM.steady
        const growth = growthLabel(g.velocity?.rcGrowthPct)
        const spark = sparkGeom(rcValues(g.velocity).slice(-14), 76, 26, 3)
        const icon = gameIconSrc(g)
        const free = priceLabel(g) === "Free"
        return (
          <li>
            <a class="mover" href={`/games/${g.id}/`}>
              <span class="mover__rank">{i + 1}</span>
              {icon && <img class="mover__icon" src={icon} srcset={g.images?.icon?.srcset} sizes="48px" alt="" width="48" height="48" loading={i < 3 ? "eager" : "lazy"} />}
              <div class="mover__meta">
                <div class="mover__name">{g.name}</div>
                <div class="mover__dev">{g.seller}{g.archetype ? ` · ${cap(g.archetype)}` : ""}</div>
                <div class="mover__badges">
                  <span class={`badge ${m.cls}`}>{m.label}</span>
                  {g.traction === "strong" && <span class="badge badge--strong">Strong traction</span>}
                  {growth && <span class="badge badge--grow">{growth} / 7d</span>}
                  {free && <span class="badge badge--free">Free</span>}
                </div>
              </div>
              {spark && (
                <svg class="mover__spark" viewBox="0 0 76 26" aria-hidden="true">
                  <path d={spark.area} class="spark-fill" />
                  <path d={spark.line} class="spark-line" />
                </svg>
              )}
              <div class="mover__heat">
                <span class="mover__heat-num">{g.heatScore}</span>
                <span class="mover__heat-lbl">heat</span>
              </div>
              <span class="mover__meter" aria-hidden="true"><i style={`width:${Math.max(2, Math.min(100, g.heatScore))}%`}></i></span>
            </a>
          </li>
        )
      })}
    </ol>
  </section>
)}

<style>
  .movers { margin: 2.5rem 0; }
  .movers .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .movers .more { font-size: .82rem; color: var(--fg-muted); }
</style>
