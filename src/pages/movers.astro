---
import Base from "../layouts/Base.astro"
import KeepBrowsing from "../components/KeepBrowsing.astro"
import ShareRow from "../components/ShareRow.astro"
import { loadEnriched, cap, priceLabel, gameIconSrc } from "../lib/enriched"
import { sparkGeom, rcValues, compactNum, growthLabel } from "../lib/spark"

const data = loadEnriched()
const all = data.all || []

const movers = all
  .filter(g => typeof g.heatScore === "number" && g.heatScore > 0)
  .sort((a, b) => (b.heatScore || 0) - (a.heatScore || 0))

const surging = movers.filter(g => g.momentum === "surging").length
const strong = movers.filter(g => g.traction === "strong").length
const freeCount = movers.filter(g => priceLabel(g) === "Free").length

const MOMENTUM = {
  surging: { label: "🔥 Surging", cls: "m-surging" },
  rising: { label: "📈 Rising", cls: "m-rising" },
  steady: { label: "Steady", cls: "m-steady" },
  fading: { label: "Fading", cls: "m-fading" },
}

/** Everything a row/podium card needs, computed once. */
function view(g: any, i: number) {
  const m = MOMENTUM[g.momentum as keyof typeof MOMENTUM] || MOMENTUM.steady
  const vals = rcValues(g.velocity)
  const rankDelta = g.velocity?.rankDelta7d ?? null
  return {
    g,
    pos: i + 1,
    m,
    free: priceLabel(g) === "Free",
    price: priceLabel(g),
    growth: growthLabel(g.velocity?.rcGrowthPct),
    newReviews: g.velocity?.rcDelta7d > 0 ? compactNum(g.velocity.rcDelta7d) : null,
    reviews: g.ratingCount ? compactNum(g.ratingCount) : null,
    // Positive rankDelta7d = climbed the chart (rank number went down).
    rankDelta: typeof rankDelta === "number" && rankDelta !== 0 ? rankDelta : null,
    spark: sparkGeom(vals.slice(-14), 76, 26, 3),
    sparkWide: sparkGeom(vals.slice(-14), 168, 46, 4),
    icon: gameIconSrc(g),
  }
}

const rows = movers.map(view)
const podium = rows.slice(0, 3)
const rest = rows.slice(3)

const dateFmt = data.date
  ? new Date(data.date + "T00:00:00Z").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })
  : ""
const site = (Astro.site || "").toString().replace(/\/$/, "")
const canonical = `${site}/movers/`
const title = "Rising iOS Games — Early Traction Radar"
const description = `${movers.length} iOS games ranked by early-traction heat: download velocity, relative growth and chart momentum. ${surging} surging, ${strong} with strong traction. Updated ${dateFmt}.`
const shareText = podium.length
  ? `Today's fastest-rising iOS game: ${podium[0].g.name} (heat ${podium[0].g.heatScore}/100).`
  : description
---
<Base title={title} description={description} canonical={canonical} image={`${site}/og-default.png`}>
  <section class="hero-band">
    <div class="eyebrow">Updated {dateFmt} · {movers.length} games tracked</div>
    <h1>Rising iOS Games</h1>
    <p class="lead">Which new and updated games are actually taking off — ranked by a heat score built from rating-count velocity, relative growth and chart momentum. Built for developers and scouts who want the signal before a game is obvious.</p>
    <div class="stat-row">
      <div class="stat"><span class="num">{surging}</span><span class="lbl">Surging</span></div>
      <div class="stat"><span class="num">{strong}</span><span class="lbl">Strong traction</span></div>
      <div class="stat"><span class="num">{movers.length}</span><span class="lbl">Total movers</span></div>
    </div>
    <ShareRow url={canonical} title={title} text={shareText} label="Share today's radar" />
  </section>

  {podium.length > 0 && (
    <section class="podium-wrap">
      <div class="section-head">
        <h2>Top 3 right now</h2>
        <span class="more">Highest heat of {movers.length} tracked games</span>
      </div>
      <ol class="podium">
        {podium.map(v => (
          <li class={`podium-card podium-card--${v.pos}`}>
            <a href={`/games/${v.g.id}/`}>
              <div class="podium-card__top">
                <span class="podium-medal" aria-label={`Rank ${v.pos}`}>{["🥇", "🥈", "🥉"][v.pos - 1]}</span>
                {v.icon && <img class="podium-icon" src={v.icon} srcset={v.g.images?.icon?.srcset} sizes="72px" alt="" width="72" height="72" loading="eager" fetchpriority="high" />}
                <div class="podium-heat">
                  <span class="podium-heat__num">{v.g.heatScore}</span>
                  <span class="podium-heat__lbl">heat</span>
                </div>
              </div>
              <div class="podium-card__name">{v.g.name}</div>
              <div class="podium-card__dev">{v.g.seller}{v.g.archetype ? ` · ${cap(v.g.archetype)}` : ""}</div>
              {v.sparkWide && (
                <svg class="podium-spark" viewBox="0 0 168 46" role="img" aria-label={`Rating-count trend, ${compactNum(v.sparkWide.first)} to ${compactNum(v.sparkWide.last)} over ${Math.min(14, rcValues(v.g.velocity).length)} days`}>
                  <path d={v.sparkWide.area} class="spark-fill" />
                  <path d={v.sparkWide.line} class="spark-line" />
                  <circle cx={v.sparkWide.lastX.toFixed(1)} cy={v.sparkWide.lastY.toFixed(1)} r="3" class="spark-dot" />
                </svg>
              )}
              <div class="podium-card__facts">
                <span class={`badge ${v.m.cls}`}>{v.m.label}</span>
                {v.growth && <span class="badge badge--grow">{v.growth} / 7d</span>}
                {v.newReviews && <span class="badge">+{v.newReviews} reviews</span>}
                <span class={`badge ${v.free ? "badge--free" : ""}`}>{v.price}</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <div class="filters-bar">
    <div class="filters" role="group" aria-label="Filter movers">
      <button class="pill active" data-filter="all" aria-pressed="true">All <span class="pill-n">{movers.length}</span></button>
      <button class="pill" data-filter="surging" aria-pressed="false">🔥 Surging <span class="pill-n">{surging}</span></button>
      <button class="pill" data-filter="strong" aria-pressed="false">Strong traction <span class="pill-n">{strong}</span></button>
      <button class="pill" data-filter="free" aria-pressed="false">Free <span class="pill-n">{freeCount}</span></button>
      <span class="filters__spacer"></span>
      <a class="pill ghost" href="/movers.xml">RSS ↗</a>
      <a class="pill ghost" href="/api/movers.json">JSON ↗</a>
    </div>
  </div>
  <p class="filters__count" data-visible-count aria-live="polite">Showing all {movers.length} games</p>

  <ol class="mover-list mover-list--v2" start="4">
    {rest.map(v => (
      <li data-momentum={v.g.momentum} data-traction={v.g.traction} data-free={v.free ? "1" : "0"}>
        <a class="mover" href={`/games/${v.g.id}/`}>
          <span class="mover__rank">{v.pos}</span>
          {v.icon && <img class="mover__icon" src={v.icon} srcset={v.g.images?.icon?.srcset} sizes="48px" alt="" width="48" height="48" loading="lazy" />}
          <div class="mover__meta">
            <div class="mover__name">{v.g.name}</div>
            <div class="mover__dev">{v.g.seller}{v.g.archetype ? ` · ${cap(v.g.archetype)}` : ""}</div>
            <div class="mover__badges">
              <span class={`badge ${v.m.cls}`}>{v.m.label}</span>
              {v.g.traction === "strong" && <span class="badge badge--strong">Strong traction</span>}
              {v.growth && <span class="badge badge--grow">{v.growth} / 7d</span>}
              {v.rankDelta && (
                <span class={`badge ${v.rankDelta > 0 ? "badge--up" : "badge--down"}`}>
                  {v.rankDelta > 0 ? "▲" : "▼"} {Math.abs(v.rankDelta)} chart
                </span>
              )}
              <span class={`badge ${v.free ? "badge--free" : ""}`}>{v.price}</span>
            </div>
          </div>
          {v.spark && (
            <svg class="mover__spark" viewBox="0 0 76 26" aria-hidden="true">
              <path d={v.spark.area} class="spark-fill" />
              <path d={v.spark.line} class="spark-line" />
            </svg>
          )}
          <div class="mover__heat">
            <span class="mover__heat-num">{v.g.heatScore}</span>
            <span class="mover__heat-lbl">heat</span>
          </div>
          <span class="mover__meter" aria-hidden="true"><i style={`width:${Math.max(2, Math.min(100, v.g.heatScore))}%`}></i></span>
        </a>
      </li>
    ))}
  </ol>

  <p class="empty-filter" data-empty hidden>No games match that filter today.</p>

  <p class="caveat">Heat is a relative, cohort-normalized signal derived from our own daily App Store snapshots (rating count is a public proxy for downloads). Chart movement is measured against the best rank we saw seven days ago. Not affiliated with Apple.</p>

  {(() => {
    const topArchetypes = [...new Set(movers.map(g => g.archetype).filter(Boolean))]
      .map(a => ({ a, n: movers.filter(g => g.archetype === a).length }))
      .sort((x, y) => y.n - x.n).slice(0, 3)
    const items = [
      { href: "/posts/", title: "Today's daily report", sub: "Every new release", icon: "calendar" },
      { href: "/games/", title: "All tracked games", sub: `${all.length} games`, icon: "list" },
      ...topArchetypes.map(t => ({ href: `/archetype/${t.a}/`, title: cap(t.a) + " games", sub: `${t.n} rising`, icon: "tag" })),
      { href: "/about/", title: "How heat is calculated", sub: "Methodology", icon: "star" },
    ].slice(0, 6)
    return <KeepBrowsing title="Where to go next" eyebrow="Keep exploring" items={items} />
  })()}

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "ItemList",
    "name": "Rising iOS Games",
    "numberOfItems": movers.length,
    "itemListElement": movers.slice(0, 20).map((g, i) => ({
      "@type": "ListItem", "position": i + 1, "name": g.name, "url": `${site}/games/${g.id}/`,
    })),
  })} />
</Base>

<script is:inline>
  (function () {
    var list = document.querySelector(".mover-list");
    var pills = document.querySelectorAll(".filters .pill[data-filter]");
    var counter = document.querySelector("[data-visible-count]");
    var empty = document.querySelector("[data-empty]");
    var podium = document.querySelector(".podium-wrap");
    if (!list) return;

    var LABEL = { all: "all", surging: "surging", strong: "strong-traction", free: "free" };

    function apply(f) {
      var shown = 0;
      list.querySelectorAll("li").forEach(function (li) {
        var show =
          f === "surging" ? li.dataset.momentum === "surging" :
          f === "strong"  ? li.dataset.traction === "strong"  :
          f === "free"    ? li.dataset.free === "1"           : true;
        li.hidden = !show;
        if (show) shown++;
      });
      // The podium is the top 3 by heat, not a filtered view — hide it when a
      // filter is on so the numbers on screen always add up.
      if (podium) podium.hidden = f !== "all";
      var total = shown + (f === "all" ? 3 : 0);
      if (counter) {
        counter.textContent = f === "all"
          ? "Showing all " + total + " games"
          : "Showing " + shown + " " + LABEL[f].replace("-", " ") + " game" + (shown === 1 ? "" : "s");
      }
      if (empty) empty.hidden = shown > 0;
    }

    pills.forEach(function (btn) {
      btn.addEventListener("click", function () {
        pills.forEach(function (b) { b.classList.remove("active"); b.setAttribute("aria-pressed", "false"); });
        btn.classList.add("active");
        btn.setAttribute("aria-pressed", "true");
        apply(btn.dataset.filter);
      });
    });
  })();
</script>
