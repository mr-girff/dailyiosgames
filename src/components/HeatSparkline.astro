---
// Rating-count trajectory, server-rendered from velocity.rcSeries.
// Rating count is a public proxy for downloads; its slope is the "is it taking
// off" signal. Renders nothing if there is no usable history yet.
import { sparkGeom, rcValues, compactNum, growthLabel } from "../lib/spark"

const { velocity } = Astro.props
const vals = rcValues(velocity)
const W = 320, H = 78
const geom = sparkGeom(vals, W, H, 6)
if (!geom) return null

const growth = growthLabel(velocity?.rcGrowthPct)
const up = (velocity?.rcVelocity || 0) > 0
const added = Number(velocity?.rcDelta7d || 0)
const days = vals.length
---
<figure class="heatspark">
  <figcaption class="heatspark__top">
    <span>Rating count · last {days} days</span>
    {growth && <strong class={up ? "is-up" : "is-down"}>{growth} / 7d</strong>}
  </figcaption>
  <svg
    class="heatspark__chart"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    role="img"
    aria-label={`Rating count over the last ${days} days: ${compactNum(geom.first)} to ${compactNum(geom.last)}${growth ? `, ${growth} in 7 days` : ""}`}
  >
    <path d={geom.area} class="spark-fill" />
    <path d={geom.line} class="spark-line" vector-effect="non-scaling-stroke" />
    <circle cx={geom.lastX.toFixed(1)} cy={geom.lastY.toFixed(1)} r="3.5" class="spark-dot" />
  </svg>
  <figcaption class="heatspark__ends">
    <span>{compactNum(geom.first)}</span>
    {added > 0 && <span class="heatspark__added">+{compactNum(added)} in 7d</span>}
    <span>{compactNum(geom.last)} reviews</span>
  </figcaption>
</figure>

<style>
  .heatspark { margin: .85rem 0 0; max-width: 420px; }
  .heatspark__top {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    font-size: .78rem; color: var(--fg-muted); margin-bottom: .35rem;
  }
  .heatspark__top .is-up { color: #35754b; }
  .heatspark__top .is-down { color: #a2503f; }
  .heatspark__chart {
    display: block; width: 100%; height: 78px;
    background: linear-gradient(180deg, var(--bg-elev), var(--muted));
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .heatspark__ends {
    display: flex; justify-content: space-between; gap: .5rem;
    font-size: .7rem; color: var(--fg-subtle); margin-top: .3rem;
    font-variant-numeric: tabular-nums;
  }
  .heatspark__added { color: #35754b; font-weight: 600; }
</style>
